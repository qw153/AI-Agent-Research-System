# 复制本文件为 .env，并填入你自己的真实值。
# cp .env.example .env        (Linux / macOS)
# copy .env.example .env      (Windows)

# --- LLM（DeepSeek 或任意 OpenAI 兼容接口）---
LLM_API_KEY=sk-你的API密钥
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 成本估算单价（人民币 / 百万 token），可选，用于展示每次研究的花费
LLM_INPUT_PRICE_PER_M=2
LLM_OUTPUT_PRICE_PER_M=8

# --- 联网搜索（Tavily，研究类问题必需）---
# 获取地址：https://tavily.com/
TAVILY_API_KEY=tvly-你的API密钥

# --- API 认证（可选，留空则关闭）---
# 设置后，请求必须带 X-API-Key 头匹配此值，防止他人盗刷你的 API
API_AUTH_TOKEN=你的API口令

# --- 记忆持久化（可选，均有默认值）---
CHECKPOINT_DB_PATH=./research_checkpoints.sqlite
MEMORY_PATH=./research_memory.json

# --- 本地向量库（预留，RAG 未实现，可忽略）---
CHROMA_DB_PATH=./chroma_db
